# Copy to .env (not tracked). Replace each placeholder before starting.
POSTGRES_USER=nexus
POSTGRES_PASSWORD=
POSTGRES_DB=nexus
NEXUS_BOOTSTRAP_TOKEN=
NEXUS_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Set true behind HTTPS, with correctly configured browser origins.
NEXUS_COOKIE_SECURE=false

# MinIO is private to the Compose network; use long random secrets.
NEXUS_S3_ACCESS_KEY=nexusminio
NEXUS_S3_SECRET_KEY=
